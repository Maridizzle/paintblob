{
  "name": "paintblob",
  "version": "0.7.32",
  "description": "A frameless desktop paint-by-number toy with big satisfying paint blobs.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "seed": "node tools/make-demo-puzzles.mjs && node tools/apply-animations.mjs && node tools/apply-tags.mjs",
    "mapify": "node tools/mapify.mjs",
    "generate": "node tools/generate-image.mjs",
    "icon": "node tools/make-icon.mjs",
    "verify": "node tools/verify-puzzle.mjs",
    "preview": "node tools/preview.mjs",
    "tag": "node tools/tag-animation.mjs",
    "animations": "node tools/apply-animations.mjs",
    "smoke": "electron . --smoke",
    "build:web": "node tools/build-web.mjs",
    "check:web": "node tools/build-web.mjs && node tools/check-web.mjs",
    "test": "node --test tools/pipeline.test.mjs tools/game-logic.test.mjs tools/zip.test.mjs tools/playstats.test.mjs && node tools/verify-puzzle.mjs",
    "dist": "npm run icon && electron-builder --publish never",
    "dist:linux": "npm run icon && electron-builder --linux --publish never",
    "dist:mac": "npm run icon && electron-builder --mac --publish never",
    "dist:win": "npm run icon && electron-builder --win --publish never"
  },
  "keywords": [
    "paint-by-number",
    "electron",
    "idle",
    "desktop-toy"
  ],
  "license": "MIT",
  "build": {
    "appId": "com.maridizzle.paintblob",
    "productName": "paintblob",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "src/**/*",
      "puzzles/*.json",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "synopsis": "Frameless desktop paint-by-number"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${name}-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "darkModeSupport": true
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.49.0",
    "pngjs": "^7.0.0"
  }
}
